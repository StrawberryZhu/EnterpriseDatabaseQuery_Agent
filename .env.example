# InsightForge Agent 环境变量模板
# 复制本文件为 .env 后填写。DASHSCOPE_API_KEY 留空时走离线 Mock 模型。

# ---- 模型接入（DashScope / 阿里云百炼） ----
DASHSCOPE_API_KEY=your_api_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
MOCK_LLM=false

# ---- 数据库凭据 ----
POSTGRES_PASSWORD=querymind
NORTHWIND_READER_PASSWORD=northwind_reader

# ---- 外部数据源凭据加密（使用 Fernet.generate_key() 生成，不要提交真实密钥） ----
DATA_SOURCE_ENCRYPTION_KEY=
DATA_SOURCE_ENCRYPTION_KEY_VERSION=1

# ---- 可选：联网搜索 MCP 工具（需 Tavily Key） ----
TAVILY_API_KEY=your_tavily_key

# ---- 运行预算与成本口径 ----
DEFAULT_TOKEN_BUDGET=20000
INPUT_COST_PER_MILLION=0.8
OUTPUT_COST_PER_MILLION=2.0
EMBEDDING_COST_PER_MILLION=0.1
